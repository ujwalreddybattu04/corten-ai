# =============================================================================
# Orivanta AI Backend — Environment Variables
# Copy this file to .env
# =============================================================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
# Official domain used to verify company descriptions and office locations.
COMPANY_WEBSITE=https://chryselys.com

# --- Database ---
DATABASE_URL=postgresql+asyncpg://corten:corten_dev@localhost:5432/corten_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
DEFAULT_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b
# Provider quotas still apply. Extra keys alone do not increase account quotas.
LLM_PROVIDER=groq
# Additional Groq credentials, tried when an earlier key is unavailable.
# Use a JSON array of strings; never commit real credentials in this example.
# Keys from the same Groq organization still share provider quotas.
GROQ_FALLBACK_API_KEYS=[]
# Optional independent hosted fallback: gemini (explicit opt-in).
LLM_FALLBACK_PROVIDER=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=2048

# --- Web Search ---
# Public pharma updates: optional openFDA key for higher request limits.
OPENFDA_API_KEY=
# Optional industry-news source (existing Guardian integration).
GUARDIAN_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
NEWSAPI_KEY=
OPENWEATHER_API_KEY=

# --- Rate Limiting ---
# Recovery stays off until the private email worker and sender are configured.
RECOVERY_EMAIL_ENABLED=false
EMAIL_FROM=ujwalreddybattu@gmail.com
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_ALLOWED_RECIPIENTS=[]
PASSWORD_RESET_EXPIRE_MINUTES=30

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=300

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

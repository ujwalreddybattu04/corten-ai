[Unit]
Description=Corten regional Pharma Bedrock gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/corten/current/deploy/aws/bedrock-gateway.py
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=corten-bedrock
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/corten/private/bedrock /run/corten-bedrock

[Install]
WantedBy=multi-user.target
